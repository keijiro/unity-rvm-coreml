:root {
    flex-grow: 1;
    --background: #131313;
    --surface: #1d1d1d;
    --border: #3c3c3c;
    --text: #ededed;
    --muted: #a2a2a2;
    --accent: #cccccc;
}

.screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    padding: 28px;
    background-color: var(--background);
    color: var(--text);
}

.header {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    padding-bottom: 20px;
    border-bottom-width: 1px;
    border-bottom-color: var(--border);
}

.source-group {
    flex-grow: 1;
    flex-basis: 320px;
    max-width: 440px;
    margin-right: 24px;
    margin-top: 4px;
}

.status-group {
    flex-shrink: 1;
    margin-top: 16px;
}

.header-label {
    margin: 0 0 8px 0;
    color: var(--muted);
    font-size: 11px;
    letter-spacing: 0.6px;
}

.source-control {
    height: 40px;
}

.source-dropdown {
    flex-grow: 1;
    margin: 0;
    padding: 0;
    min-width: 0;
}

.source-dropdown > .unity-base-popup-field__input {
    flex-grow: 1;
    min-width: 0;
    min-height: 40px;
    margin: 0;
    padding: 0 38px 0 14px;
    flex-direction: row;
    align-items: center;
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--border);
    border-radius: 3px;
}

.source-dropdown:hover > .unity-base-popup-field__input {
    background-color: #2a2a2a;
    border-color: #707070;
}

.source-dropdown:focus > .unity-base-popup-field__input {
    border-color: var(--accent);
}

.source-dropdown:disabled > .unity-base-popup-field__input {
    opacity: 0.45;
}

.source-dropdown .unity-base-popup-field__text {
    flex-grow: 1;
    min-width: 0;
    margin: 0;
    padding: 0;
    color: var(--text);
    font-size: 14px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    -unity-text-align: middle-left;
}

.source-dropdown .unity-base-popup-field__arrow {
    display: none;
}

.source-dropdown-icon {
    position: absolute;
    top: 0;
    right: 14px;
    bottom: 0;
    width: 12px;
    margin: 0;
    padding: 0;
    color: var(--accent);
    font-size: 16px;
    -unity-text-align: middle-center;
}

.status {
    min-height: 40px;
    margin: 0;
    padding: 0;
    color: var(--accent);
    font-size: 12px;
    white-space: normal;
    -unity-text-align: middle-left;
}

.viewports {
    flex-grow: 1;
    min-height: 0;
    margin-top: 24px;
    flex-direction: row;
    align-items: center;
}

.viewport-panel {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    padding: 12px;
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--border);
    border-radius: 4px;
}

.viewport-panel-left {
    margin-right: 10px;
}

.viewport-panel-right {
    margin-left: 10px;
}

.viewport-title {
    margin: 0 0 12px 0;
    color: var(--muted);
    font-size: 12px;
    letter-spacing: 0.3px;
    white-space: nowrap;
}

.viewport-image {
    aspect-ratio: 1.777778;
    background-color: #0a0a0a;
    border-radius: 2px;
    overflow: hidden;
}
