<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="../RVM/UI/Main.uss" />
    <ui:VisualElement name="root" class="screen">
        <ui:VisualElement class="header">
            <ui:VisualElement class="source-group">
                <ui:VisualElement class="source-control">
                    <ui:DropdownField name="sourceDropdown" class="source-dropdown" />
                    <ui:Label text="▾" picking-mode="Ignore" class="source-dropdown-icon" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="sync-group">
                <ui:Toggle name="matteTriggeredSyncToggle" label="Matte-Triggered Sync" class="sync-toggle" />
            </ui:VisualElement>
            <ui:VisualElement class="status-group">
                <ui:Label text="Inference time" class="inference-label" />
                <ui:VisualElement class="status-value">
                    <!-- Reserve the formatted reading's width using the current font. -->
                    <ui:Label text="0000.0 ms" picking-mode="Ignore" class="status status-size" />
                    <ui:Label name="statusLabel" class="status status-reading" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="viewports">
            <ui:VisualElement class="viewport-panel viewport-panel-left">
                <ui:Label text="Model input" class="viewport-title" />
                <ui:Image name="cameraImage" class="viewport-image" />
            </ui:VisualElement>
            <ui:VisualElement class="viewport-panel viewport-panel-middle">
                <ui:Label text="Alpha matte" class="viewport-title" />
                <ui:Image name="alphaImage" class="viewport-image" />
            </ui:VisualElement>
            <ui:VisualElement class="viewport-panel viewport-panel-right">
                <ui:Label text="Tinted composite" class="viewport-title" />
                <ui:Image name="compositeImage" class="viewport-image" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
