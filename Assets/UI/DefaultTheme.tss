.unity-base-dropdown {
    /* The popup is a sibling of the panel content. Keep it out of flex layout
       so opening it does not collapse the panel behind it. */
    position: absolute;
}

.unity-base-dropdown__container-outer {
    padding: 6px;
    background-color: #1d1d1d;
    border-left-width: 1px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-color: #707070;
    border-radius: 3px;
}

.unity-base-dropdown__container-inner {
    background-color: #1d1d1d;
}

.unity-base-dropdown__item {
    height: 40px;
}

.unity-base-dropdown__item-content {
    flex-direction: row;
    align-items: center;
    height: 40px;
    padding-left: 12px;
    padding-right: 12px;
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-right-radius: 2px;
    border-bottom-left-radius: 2px;
}

.unity-base-dropdown__item:hover > .unity-base-dropdown__item-content {
    background-color: #383838;
}

.unity-base-dropdown__item:checked > .unity-base-dropdown__item-content {
    background-color: #3b3b3b;
}

.unity-base-dropdown__item:checked:hover > .unity-base-dropdown__item-content {
    background-color: #4d4d4d;
}

.unity-base-dropdown__checkmark {
    display: none;
}

.unity-base-dropdown__label {
    flex-grow: 1;
    min-width: 0;
    margin: 0;
    padding: 0;
    color: #ededed;
    font-size: 14px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    -unity-text-align: middle-left;
}
